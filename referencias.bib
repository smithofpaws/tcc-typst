% EXEMPLOS PARA DEMONSTRAÇÃO DE FORMATAÇÃO
% Exemplos adaptados do template LaTeX V2 da UNIPAMPA (Charles Quevedo Carpes, 2026),
% seguindo o Manual de normalização de referências da UNIPAMPA (2025).
% Os dados servem apenas de modelo e não foram conferidos nas obras originais.
% Não cite estes registros em trabalhos reais sem verificar os documentos.
%
% ORIENTAÇÕES PARA O TYPST
%
% - Somente as obras citadas no texto aparecem nas referências.
% - Separe autores com "and". O Typst não reconhece "and others": para gerar
%   o et al., informe todos os autores (o estilo abrevia a partir de quatro).
% - Subtítulo: use o campo note. O estilo imprime "Título: subtítulo" e
%   destaca somente o título. Não use note para outras informações.
% - Data de acesso: use urldate no formato AAAA-MM-DD.
% - Datas com dia e mês: use date = {AAAA-MM-DD} ou {AAAA-MM}. Intervalos de
%   meses (jan./abr.) não são suportados; informe apenas o ano nesses casos.
% - Sem local de publicação: omita address; o estilo imprime [S. l.].
%   Sem editora: omita publisher; o estilo imprime [s. n.].
% - Instituição de TCC, dissertação e tese: use school ou institution.
% - Caracteres especiais: escreva \& para o "e comercial".

% LIVRO CONSULTADO ONLINE, SEM LOCAL DE PUBLICAÇÃO IDENTIFICADO.

@book{alves2000,
  author    = {Alves, Castro},
  title     = {Navio negreiro},
  publisher = {Virtual Books},
  year      = {2000},
  url       = {http://www.terra.com.br/virtualbooks/freebook/port/Lport2/navionegreiro.htm},
  urldate   = {2002-01-10}
}

